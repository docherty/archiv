{
  "manifest_version": 3,
  "name": "Venice History Sync",
  "version": "0.3.4",
  "description": "Create complete incremental local archives of Venice.ai conversations, Studio media, and attachments",
  
  "permissions": [
    "scripting",
    "activeTab",
    "storage",
    "tabs",
    "downloads"
  ],
  
  "host_permissions": [
    "https://venice.ai/*",
    "https://*.venice.ai/*"
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "content_scripts": [
    {
      "matches": ["https://venice.ai/*", "https://*.venice.ai/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Venice History Sync",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "web_accessible_resources": [
    {
      "resources": ["content-main.js", "lib/nacl.min.js"],
      "matches": ["https://venice.ai/*"]
    }
  ]
}
